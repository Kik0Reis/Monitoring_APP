SECRET_KEY=

DEBUG=

ALLOWED_HOSTS=

MQTT_HOST=
MQTT_PORT=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=

MQTT_TLS=
MQTT_TOPIC=

# How many days of DeviceHeartbeat rows to keep before the cleanup job
# deletes them. Heartbeats can arrive every few seconds per device, so
# without a limit this table grows without bound.
HEARTBEAT_RETENTION_DAYS=14

# How often (in hours) the heartbeat_worker process runs the cleanup job.
HEARTBEAT_CLEANUP_INTERVAL_HOURS=24

# Resolved (inactive) DeviceAlert/CameraAlert rows older than this are
# deleted by the same cleanup job.
ALERT_RETENTION_DAYS=30

# DEVICE_ERROR/CAMERA_ERROR alerts with no explicit "resolved" MQTT
# message auto-resolve once they haven't been re-reported for this long.
ALERT_STALE_HOURS=24

# How many days of camera detections (smoke/person/etc events) to keep
# and show.
DETECTION_RETENTION_DAYS=10
