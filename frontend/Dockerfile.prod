# Stage 1: compile the React/Vite app into static files (dist/).
FROM node:22 AS build

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .
RUN npm run build

# Stage 2: serve the compiled static files with Nginx. No Node.js exists
# in this final image at all -- unlike the dev Dockerfile, which runs
# `npm run dev` directly.
FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Username/password used by Nginx HTTP Basic Auth
COPY .htpasswd /etc/nginx/.htpasswd

EXPOSE 80