# Copy this to .env.prod and fill in real values. Never commit .env.prod
# itself -- only this .example file belongs in version control.

# Generate a fresh one, don't reuse the dev SECRET_KEY:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

DEBUG=False

# Whatever hostname/IP clients will use to reach this server, comma
# separated. For a local/Tailscale-only server this is typically the
# machine's LAN IP and/or its Tailscale MagicDNS name, e.g.:
#   ALLOWED_HOSTS=192.168.1.50,my-server.tailnet-name.ts.net
ALLOWED_HOSTS=

MQTT_HOST=
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60

MQTT_TLS=True
MQTT_RECONCILE_INTERVAL_MINUTES=30
MQTT_RECONCILE_WINDOW_SECONDS=15
HEARTBEAT_RETENTION_DAYS=14
HEARTBEAT_CLEANUP_INTERVAL_HOURS=24
ALERT_RETENTION_DAYS=30

# DEVICE_ERROR/CAMERA_ERROR alerts with no explicit "resolved" MQTT
# message auto-resolve once they haven't been re-reported for this long.
ALERT_STALE_HOURS=24

# How many days of camera detections (smoke/person/etc events) to keep
# and show.
DETECTION_RETENTION_DAYS=10
